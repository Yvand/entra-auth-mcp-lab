{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "version": "1.0.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "Yvand",
    "websiteUrl": "https://github.com/Yvand/entra-mcp-identity-lab",
    "privacyUrl": "https://github.com/Yvand/entra-mcp-identity-lab",
    "termsOfUseUrl": "https://github.com/Yvand/entra-mcp-identity-lab"
  },
  "name": {
    "short": "Entra MCP Lab - Chat${{APP_NAME_SUFFIX}}",
    "full": "Entra MCP Identity Lab - Chat${{APP_NAME_SUFFIX}}"
  },
  "description": {
    "short": "Test delegated MCP authentication with identity and echo tools.",
    "full": "Entra MCP Identity Lab for Microsoft 365 Copilot Chat: a learning demo declarative agent that calls whoami and echo on an Entra-protected remote MCP server."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#2563EB",
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "entraMcpIdentityLabAgent",
        "file": "declarativeAgent.json"
      }
    ]
  }
}
