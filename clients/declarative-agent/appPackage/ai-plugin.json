{
  "$schema": "https://developer.microsoft.com/json-schemas/copilot/plugin/v2.4/schema.json",
  "schema_version": "v2.4",
  "name_for_human": "Entra MCP Lab",
  "description_for_human": "Entra MCP Identity Lab: identify the signed-in user and echo a message.",
  "namespace": "EntraMcpIdentityLab",
  "functions": [],
  "runtimes": [
    {
      "type": "RemoteMCPServer",
      "spec": {
        "url": "${{MCP_ENDPOINT}}"
      },
      "run_for_functions": ["*"],
      "auth": {
        "type": "OAuthPluginVault",
        "reference_id": "${{MCP_AUTH_CONFIG_ID}}"
      }
    }
  ]
}
